{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Gravity",
  "mainBinaryName": "OpenGravity",
  "version": "3.0.0",
  "identifier": "com.opengravity.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Open Gravity",
    "copyright": "MIT License, Open Gravity contributors",
    "shortDescription": "Universal local AI router",
    "longDescription": "One local endpoint for every AI model: 100+ providers, automatic tool calling, fallback combos, key rotation, token saver and usage analytics.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}

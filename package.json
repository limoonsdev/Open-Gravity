{
  "name": "open-gravity",
  "version": "2.0.0",
  "description": "Universal local AI router: one endpoint for OpenAI, Anthropic, Gemini, OpenRouter, Groq, DeepSeek, Ollama, Antigravity and more, with combos, fallback, key rotation, usage analytics and a built-in web panel. Ships as a single executable.",
  "main": "build/open-gravity.cjs",
  "bin": {
    "open-gravity": "bin/open-gravity.js",
    "og": "bin/open-gravity.js"
  },
  "files": [
    "bin",
    "build/open-gravity.cjs",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node build/open-gravity.cjs",
    "exe": "node scripts/build-exe.mjs",
    "exe:win": "node scripts/build-exe.mjs --target win-x64",
    "exe:all": "node scripts/build-exe.mjs --target win-x64,linux-x64,macos-arm64,macos-x64",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai-router",
    "llm-proxy",
    "llm-gateway",
    "openai-compatible",
    "anthropic-compatible",
    "gemini",
    "claude-code",
    "codex",
    "cursor",
    "openrouter",
    "antigravity",
    "fallback",
    "load-balancing"
  ],
  "author": "Alexis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/limoonsdev/Open-Gravity.git"
  },
  "dependencies": {
    "undici": "^6.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^2.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
